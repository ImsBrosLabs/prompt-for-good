# Copy this file to .env before using Docker Compose locally.
# Safe defaults are provided for development and tests.

PFG_HUB_PORT=8080
PFG_POSTGRES_PORT=5432

# Hub
ADMIN_KEY=dev-admin-key
GITHUB_TOKEN=
GITHUB_INGESTION_ENABLED=false
GITHUB_INGESTION_CRON="0 */6 * * *"
GITHUB_RECRAWL_AFTER_MS=21600000
GITHUB_MAX_RETRIES=3
GITHUB_BACKOFF_BASE_MS=1000

# Agent / runner
PFG_HUB_URL=http://hub:8080
PFG_TOKEN=test-token
RUNNER_ID=00000000-0000-0000-0000-000000000000
ANTHROPIC_API_KEY=sk-ant-test-key
CONTRIBUTOR_NAME=anonymous
MAX_TOKENS_PER_DAY=100000
